---
import type { ArchivoRef } from "../data/portafolios";
import PreviewModal from "./PreviewModal";
import Reveal from './Reveal';

interface Work {
  title: string;
  desc: string;
  competencias: string[];
  reflexion: string;
  archivo?: ArchivoRef;
  archivo2?: ArchivoRef;
}

const { works, finalReflection } = Astro.props as {
  works: Work[];
  finalReflection: string;
};

const gradients = [
  "linear-gradient(135deg, var(--color-lavender-light), var(--color-tan))",
  "linear-gradient(135deg, var(--color-tan), var(--color-surface))",
  "linear-gradient(135deg, var(--color-lavender), var(--color-lavender-light))",
];
---

<div class="work-grid">
  {works.map((work, i) => (
    <Reveal delay={i * 60} client:visible>
      <article class="work-card">
        <PreviewModal
          titulo={work.title}
          items={[
            work.archivo && { tipo: work.archivo.tipo, ruta: work.archivo.ruta },
            work.archivo2 && { tipo: work.archivo2.tipo, ruta: work.archivo2.ruta, label: "Adicional" },
          ].filter(Boolean)}
          client:load
        >
          <div
            class="placeholder-photo"
            style={`width:100%; height:100%; background:${gradients[i % gradients.length]}; font-size:13px`}
          >
            {work.archivo?.tipo === "imagen" ? (
              <img
                src={work.archivo.ruta}
                alt={work.title}
                style="width:100%;height:100%;object-fit:cover;display:block"
              />
            ) : work.archivo?.tipo === "pdf" ? (
              <span style="font-size:40px">📄</span>
            ) : work.archivo?.tipo === "video" ? (
              <span style="font-size:40px">▶</span>
            ) : (
              <span style="font-family:var(--font-serif);font-style:italic;font-size:13px">
                {work.title}
              </span>
            )}
          </div>
        </PreviewModal>
        <div class="work-body">
          <h3>{work.title}</h3>
          <p>{work.desc}</p>
          <div style="margin-top:16px">
            <div class="eyebrow" style="font-size:10px; margin-bottom:8px">Competencias</div>
            <div class="tag-cloud">
              {work.competencias.map((competencia) => (
                <span class="tag" style="padding:7px 12px; font-size:12px">{competencia}</span>
              ))}
            </div>
          </div>
          <div style="margin-top:16px; padding-top:14px; border-top:1px solid rgba(165,147,123,0.16)">
            <div class="eyebrow" style="font-size:10px; margin-bottom:8px">Reflexión</div>
            <p style="font-size:13px; margin:0">{work.reflexion}</p>
          </div>
        </div>
      </article>
    </Reveal>
  ))}
</div>

<Reveal client:visible>
  <div class="declaration" style="margin-top:64px; padding:56px 40px">
    <span class="eyebrow" style="display:block; margin-bottom:12px">Reflexión final</span>
    <p class="declaration-quote" style="font-size:clamp(22px, 3vw, 34px)">
      «{finalReflection}»
    </p>
    <div class="declaration-attr">— Tirzah S. Kook</div>
  </div>
</Reveal>
