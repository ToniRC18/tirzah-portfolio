---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import PortfolioGrid from '../../components/PortfolioGrid';
import PortfolioSubNav from '../../components/PortfolioSubNav.astro';
import { PORTFOLIO_DATA } from '../../data/portafolios';

const data = PORTFOLIO_DATA.iii;
---

<Base title="Portafolio III — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow="04 · Portafolio III" title={data.semester} lead={data.desc} decor="III" client:load />
    <section class="container" style="padding-bottom:var(--pad-section)">
      <PortfolioGrid data={data} which="iii" client:load />
      <PortfolioSubNav portfolio="iii" current="Académico-profesional" />
    </section>
  </div>
</Base>
