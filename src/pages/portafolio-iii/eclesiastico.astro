---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import PortfolioSubNav from '../../components/PortfolioSubNav.astro';
import SubpageWorkGrid from '../../components/SubpageWorkGrid.astro';
import { PORTFOLIO_SUBPAGES } from '../../data/portfolioSubpages';

const page = PORTFOLIO_SUBPAGES.iii.eclesiastico;
---

<Base title="Portafolio III · Eclesiástico — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow={page.eyebrow} title={page.title} lead={page.lead} decor="III" client:load />
    <section class="container" style="padding-bottom:var(--pad-section)">
      <SubpageWorkGrid works={page.works} finalReflection={page.finalReflection} />
      <PortfolioSubNav portfolio="iii" current="Eclesiástico" />
    </section>
  </div>
</Base>
