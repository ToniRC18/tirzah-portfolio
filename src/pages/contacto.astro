---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader';
import ContactForm from '../components/ContactForm';
---

<Base title="Contacto — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="Contacto"
      title="Hablemos"
      lead="¿Tienes alguna pregunta sobre algún trabajo, te interesa colaborar en investigación o quieres ponerte en contacto por otra razón? Con gusto te respondo."
      decor="✦"
      client:load
    />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div class="contact-grid">
        <div>
          <span class="eyebrow">Datos directos</span>
          <h2 style="margin-top:8px; margin-bottom:16px; font-size:28px">Donde puedes encontrarme</h2>
          <p class="lead" style="font-size:16px; max-width:44ch">
            La forma más rápida de contactarme es por correo. También respondo mensajes
            directos por Instagram durante la semana, fuera de horario de clases.
          </p>

          <div class="contact-info-list">
            <a class="contact-info-item" href="mailto:tirzah.kook@um.edu.mx">
              <div class="icon-wrap" style="width:40px; height:40px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; flex-shrink:0">
                ✉
              </div>
              <div>
                <span class="lbl">Correo</span>
                <span class="val">tirzah.kook@um.edu.mx</span>
              </div>
            </a>
            <a class="contact-info-item" href="https://instagram.com/tirzah.kook" target="_blank" rel="noreferrer">
              <div class="icon-wrap" style="width:40px; height:40px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; flex-shrink:0">
                📷
              </div>
              <div>
                <span class="lbl">Instagram</span>
                <span class="val">@tirzah.kook</span>
              </div>
            </a>
            <div class="contact-info-item">
              <div class="icon-wrap" style="width:40px; height:40px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; flex-shrink:0">
                📍
              </div>
              <div>
                <span class="lbl">Ubicación</span>
                <span class="val">Montemorelos, Nuevo León · México</span>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="icon-wrap" style="width:40px; height:40px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; flex-shrink:0">
                🎓
              </div>
              <div>
                <span class="lbl">Universidad</span>
                <span class="val">Universidad de Montemorelos</span>
              </div>
            </div>
          </div>
        </div>

        <ContactForm client:load />
      </div>
    </section>
  </div>
</Base>
