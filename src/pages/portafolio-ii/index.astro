---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import PortfolioGrid from '../../components/PortfolioGrid';
import PortfolioSubNav from '../../components/PortfolioSubNav.astro';
import { PORTFOLIO_DATA } from '../../data/portafolios';

const data = PORTFOLIO_DATA.ii;
---

<Base title="Portafolio II — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow="04 · Portafolio II" title={data.semester} lead={data.desc} decor="II" client:load />
    <section class="container" style="padding-bottom:var(--pad-section)">
      <PortfolioGrid data={data} which="ii" client:load />
      <PortfolioSubNav portfolio="ii" current="Académico-profesional" />
    </section>
  </div>
</Base>
