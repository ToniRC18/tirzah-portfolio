---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import PortfolioSubNav from '../../components/PortfolioSubNav.astro';
import CompetenciasTable from '../../components/CompetenciasTable';

const cosmovision = [
  { texto: "Tomar decisiones sabias basadas en los principios de la Santa Biblia.", porcentaje: 46 },
  { texto: "Al proyectar una vida profesional, personal y familiar en el marco de un compromiso moral y misional.", porcentaje: 43 },
  { texto: "Al vivir una vida equilibrada teniendo especial cuidado en el uso del tiempo, las finanzas, las habilidades y la salud.", porcentaje: 50 },
  { texto: "Al desarrollar un gusto sano por la recreación, las manifestaciones artísticas y culturales y los medios.", porcentaje: 50 },
  { texto: "Al practicar los aspectos éticos, morales y legales del ejercicio profesional de la psicología clínica, sustentados en una cosmovisión bíblica.", porcentaje: 42 },
];

const generacion = [
  { texto: "Transferir de modo pertinente e innovador el conocimiento profesional a situaciones laborales reales.", porcentaje: 33 },
  { texto: "Elaborar diagnósticos y tratamientos de padecimientos psicológicos.", porcentaje: 32 },
  { texto: "Modificar conductas y pensamientos disfuncionales de los pacientes.", porcentaje: 30 },
  { texto: "Diseñar e implementar programas y proyectos que promuevan el bienestar psicológico.", porcentaje: 30 },
  { texto: "Realizar intervenciones psicológicas positivas potenciando las fortalezas y virtudes de los pacientes.", porcentaje: 30 },
  { texto: "Generar aportes significativos a partir de proyectos de investigación.", porcentaje: 32 },
  { texto: "Al comunicarse en forma oral y escrita en español.", porcentaje: 44 },
  { texto: "Al identificar, plantear y resolver problemas aplicando el pensamiento crítico.", porcentaje: 40 },
  { texto: "Al usar correctamente las tecnologías de la información y comunicación.", porcentaje: 44 },
  { texto: "Al trabajar en equipos inter y multidisciplinarios.", porcentaje: 36 },
];

const integracion = [
  { texto: "Concretar proyectos emprendedores de servicio con visión misionera.", porcentaje: 40 },
  { texto: "Al identificar y atender las necesidades de los demás.", porcentaje: 45 },
  { texto: "Al comunicarse en un segundo idioma.", porcentaje: 95 },
  { texto: "Al autofinanciar el proyecto educativo.", porcentaje: 40 },
  { texto: "Al valorar y respetar la diversidad y multiculturalidad.", porcentaje: 50 },
  { texto: "Al mantener buenas relaciones interpersonales.", porcentaje: 45 },
  { texto: "Al tomar iniciativas para el servicio abnegado.", porcentaje: 42 },
  { texto: "Al tomar iniciativas para la preservación del medio ambiente y la sustentabilidad.", porcentaje: 20 },
  { texto: "Al trabajar de modo colaborativo con organizaciones gubernamentales u ONG.", porcentaje: 38 },
  { texto: "Al Promover el desarrollo integral y el bienestar de las comunidades.", porcentaje: 38 },
];
---

<Base title="Tabla de competencias — Portafolio II">
  <div class="page">
    <PageHeader
      eyebrow="Portafolio II · Competencias alcanzadas"
      title="Tabla de competencias"
      lead="Porcentaje de alcance de cada competencia del perfil de egreso documentado durante el segundo periodo de formación."
      decor="II"
      client:load
    />
    <section class="container" style="padding-bottom: var(--pad-section)">
      <h2 style="margin-bottom: 20px; font-size: 22px;">Competencias de Cosmovisión</h2>
      <CompetenciasTable titulo="Cosmovisión" competencias={cosmovision} client:load />

      <h2 style="margin-bottom: 20px; margin-top: 48px; font-size: 22px;">Competencias de Generación y Aplicación del Conocimiento</h2>
      <CompetenciasTable titulo="Generación" competencias={generacion} client:load />

      <h2 style="margin-bottom: 20px; margin-top: 48px; font-size: 22px;">Competencias de Integración</h2>
      <CompetenciasTable titulo="Integración" competencias={integracion} client:load />

      <PortfolioSubNav portfolio="ii" current="Tabla de competencias" />
    </section>
  </div>
</Base>
