---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import CompetencyTable from '../../components/CompetencyTable.astro';
import PortfolioSubNav from '../../components/PortfolioSubNav.astro';
---

<Base title="Portafolio II · Tabla de competencias — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="Portafolio II · Tabla de competencias"
      title="Competencias alcanzadas"
      lead="Tabla visual de las competencias institucionales acumuladas hasta el Portafolio II."
      decor="II"
      client:load
    />
    <section class="container" style="padding-bottom:var(--pad-section)">
      <CompetencyTable portfolio="ii" />
      <PortfolioSubNav portfolio="ii" current="Tabla de competencias" />
    </section>
  </div>
</Base>
