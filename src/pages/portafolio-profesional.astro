---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader';
import Reveal from '../components/Reveal';

const experiences = [
  {
    logo: "U", status: "Actual", statusType: "current",
    period: "Enero 2025 — actual", hours: "120+ hrs",
    title: "Asistente de cátedra · Psicología del Desarrollo I",
    org: "Universidad de Montemorelos · Dra. R. Castañeda",
    bullets: [
      "Apoyo en la preparación de materiales didácticos y selección de lecturas",
      "Tutoría académica semanal a estudiantes de 1er semestre",
      "Coordinación logística de seminarios invitados",
    ],
  },
  {
    logo: "B", status: "Actual", statusType: "current",
    period: "Agosto 2024 — actual", hours: "80+ hrs",
    title: "Voluntaria · Brigada de salud mental comunitaria",
    org: "Universidad de Montemorelos · General Terán, NL",
    bullets: [
      "Talleres mensuales de bienestar emocional con grupos de mujeres adultas",
      "Aplicación de tamizajes breves de malestar emocional bajo supervisión",
      "Coordinación con la clínica comunitaria de la UM para derivaciones",
    ],
  },
  {
    logo: "C", status: "Completada", statusType: "complete",
    period: "Verano 2025", hours: "60 hrs",
    title: "Práctica de observación · Centro de atención psicológica",
    org: "CAP-UM · Supervisora: Mtra. L. Velasco",
    bullets: [
      "Observación de 14 sesiones de terapia en setting institucional",
      "Bitácora reflexiva semanal con énfasis en transferencia y encuadre",
      "Participación en sesiones quincenales de discusión clínica",
    ],
  },
  {
    logo: "T", status: "Completada", statusType: "complete",
    period: "Verano 2024", hours: "40 hrs",
    title: "Curso intensivo · Primeros auxilios psicológicos",
    org: "Cruz Roja Mexicana · Delegación Monterrey",
    bullets: [
      "Certificación en primeros auxilios psicológicos (PAP) post-crisis",
      "Práctica supervisada en simulacros de intervención",
    ],
  },
];

const habilidadesClinicas = [
  { name: "Entrevista clínica inicial", lvl: 70 },
  { name: "Aplicación de pruebas psicométricas", lvl: 75 },
  { name: "Formulación de caso", lvl: 65 },
  { name: "Intervención en crisis (PAP)", lvl: 60 },
  { name: "Documentación clínica", lvl: 80 },
];

const competenciasTransversales = [
  "Escucha activa", "Redacción APA 7", "Pensamiento crítico",
  "Análisis cualitativo (ATLAS.ti)", "SPSS / Jamovi", "Trabajo en equipo",
  "Comunicación intercultural", "Ética clínica", "Investigación bibliográfica",
  "Gestión del tiempo", "Mentoring entre pares", "Lectura científica en inglés",
];
---

<Base title="Portafolio profesional — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="06 · Portafolio profesional"
      title="Experiencia formativa fuera del aula"
      lead="Las prácticas, voluntariados y formaciones complementarias que han ido configurando mi identidad profesional como psicóloga clínica en formación."
      decor="06"
      client:load
    />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <span class="eyebrow">Experiencias</span>
      <h2 style="margin-top:8px; margin-bottom:32px">Trayectoria reciente</h2>

      <div class="experience-list">
        {experiences.map((e, i) => (
          <Reveal delay={i * 80} client:visible>
            <div class="experience-item">
              <div class="exp-logo">{e.logo}</div>
              <div>
                <div class="exp-meta">
                  <span>📅 {e.period}</span>
                  <span style="color:var(--color-tan)">·</span>
                  <span>{e.hours}</span>
                </div>
                <div class="exp-title">{e.title}</div>
                <div class="exp-org">{e.org}</div>
                <ul class="exp-bullets">
                  {e.bullets.map(b => <li>{b}</li>)}
                </ul>
              </div>
              <div>
                <span class={`exp-status ${e.statusType === 'complete' ? 'complete' : ''}`}>
                  {e.status}
                </span>
              </div>
            </div>
          </Reveal>
        ))}
      </div>

      <div class="skills-section">
        <Reveal client:visible>
          <div>
            <span class="eyebrow">Habilidades clínicas</span>
            <h3 style="margin-top:8px; margin-bottom:24px; font-size:24px">En desarrollo</h3>
            <div>
              {habilidadesClinicas.map(s => (
                <div class="skill-bar" style="grid-template-columns:180px 1fr 50px">
                  <span style="font-size:14px">{s.name}</span>
                  <div class="lvl-track"><div class="lvl-fill" style={`width:${s.lvl}%`}></div></div>
                  <span class="lvl-num">{s.lvl}</span>
                </div>
              ))}
            </div>
            <p class="text-muted" style="font-size:12px; font-style:italic; margin-top:16px; font-family:var(--font-serif)">
              * Autoevaluación. Las habilidades clínicas se profundizan en supervisión a partir del 5° semestre.
            </p>
          </div>
        </Reveal>

        <Reveal delay={100} client:visible>
          <div>
            <span class="eyebrow">Competencias transversales</span>
            <h3 style="margin-top:8px; margin-bottom:24px; font-size:24px">Lo que llevo en la mochila</h3>
            <div class="tag-cloud">
              {competenciasTransversales.map(c => (
                <span class="tag" style="padding:8px 16px; font-size:14px">{c}</span>
              ))}
            </div>
          </div>
        </Reveal>
      </div>
    </section>
  </div>
</Base>
