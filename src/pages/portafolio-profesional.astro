---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader';
import Reveal from '../components/Reveal';

const canvaUrl = "https://canva.link/cup5b5f8qw1yb7v";

const experiences = [
  {
    logo: "J",
    status: "Completada",
    statusType: "complete",
    period: "2023",
    title: "Voluntaria en atención psicológica a jóvenes",
    org: "Instituto Municipal de la Juventud",
  },
  {
    logo: "I",
    status: "Completada",
    statusType: "complete",
    period: "2023 — 2025",
    title: "Docente de Inglés",
    org: "Instituto de Idiomas",
  },
  {
    logo: "C",
    status: "Completada",
    statusType: "complete",
    period: "2019",
    title: "Representante editorial IADPA",
    org: "Colportaje",
  },
];
---

<Base title="Portafolio profesional — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="06 · Portafolio profesional"
      title="Experiencia formativa y profesional"
      lead="Mi portafolio profesional está disponible en Canva, donde encontrarás mi experiencia formativa, voluntariados y habilidades desarrolladas a lo largo de la carrera."
      decor="06"
      client:load
    />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <Reveal client:visible>
        <div class="declaration" style="padding:64px 40px; margin-bottom:48px">
          <span class="eyebrow" style="display:block; margin-bottom:12px">Canva</span>
          <p class="declaration-quote" style="font-size:clamp(24px, 4vw, 42px)">
            Mi portafolio profesional está disponible en Canva.
          </p>
          <div style="margin-top:28px">
            <a class="btn btn-primary" href={canvaUrl} target="_blank" rel="noreferrer">
              Ver portafolio profesional →
            </a>
          </div>
        </div>
      </Reveal>

      <span class="eyebrow">Experiencias reales</span>
      <h2 style="margin-top:8px; margin-bottom:32px">Trayectoria</h2>

      <div class="experience-list">
        {experiences.map((e, i) => (
          <Reveal delay={i * 80} client:visible>
            <div class="experience-item">
              <div class="exp-logo">{e.logo}</div>
              <div>
                <div class="exp-meta">
                  <span>📅 {e.period}</span>
                </div>
                <div class="exp-title">{e.title}</div>
                <div class="exp-org">{e.org}</div>
              </div>
              <div>
                <span class={`exp-status ${e.statusType === 'complete' ? 'complete' : ''}`}>
                  {e.status}
                </span>
              </div>
            </div>
          </Reveal>
        ))}
      </div>
    </section>
  </div>
</Base>
