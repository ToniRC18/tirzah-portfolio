---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import Reveal from '../../components/Reveal';

const items = [
  { icon: '1', title: "Atención a necesidades", desc: "Al identificar y atender las necesidades de los demás." },
  { icon: '2', title: "Segundo idioma", desc: "Al comunicarse en un segundo idioma." },
  { icon: '3', title: "Autofinanciamiento", desc: "Al autofinanciar el proyecto educativo." },
  { icon: '4', title: "Diversidad y multiculturalidad", desc: "Al valorar y respetar la diversidad y multiculturalidad." },
  { icon: '5', title: "Relaciones interpersonales", desc: "Al mantener buenas relaciones interpersonales." },
  { icon: '6', title: "Servicio abnegado", desc: "Al tomar iniciativas para el servicio abnegado." },
  { icon: '7', title: "Sustentabilidad", desc: "Al tomar iniciativas para la preservación del medio ambiente y la sustentabilidad." },
  { icon: '8', title: "Colaboración con organizaciones", desc: "Al trabajar de modo colaborativo con organizaciones gubernamentales u ONG para el bienestar integral individual y de la comunidad." },
  { icon: '9', title: "Liderazgo de servicio cristiano", desc: "Al promover el desarrollo integral y el bienestar de las comunidades, con un liderazgo de servicio cristiano y una visión misionera, trabajando en equipos multidisciplinarios de atención psicológica." },
];
---

<Base title="Perfil de Egreso · Integración — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="Perfil de Egreso · 03/3"
      title="Integración"
      lead="Concretar proyectos emprendedores de servicio, con una visión misionera, en distintos contextos para promover el bienestar integral."
      client:load
    />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div style="display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap">
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso">← Volver al perfil</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/cosmovision">Cosmovisión</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/generacion">Generación y Aplicación</a>
        <a class="btn btn-primary btn-sm" href="/perfil-egreso/integracion">Integración</a>
      </div>

      <div class="competency-list">
        {items.map((it, i) => (
          <Reveal delay={i * 80} client:visible>
            <div class="competency-item">
              <div class="icon-wrap" style="flex-shrink:0; width:44px; height:44px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; font-size:20px">
                {it.icon}
              </div>
              <div style="flex:1">
                <h4>{it.title}</h4>
                <p>{it.desc}</p>
                <span class="evidence">Competencia de egreso</span>
              </div>
            </div>
          </Reveal>
        ))}
      </div>

      <div style="margin-top:64px; display:flex; justify-content:space-between; align-items:center; padding:24px 0; border-top:1px solid rgba(165,147,123,0.2); border-bottom:1px solid rgba(165,147,123,0.2); flex-wrap:wrap; gap:16px">
        <div>
          <div class="eyebrow">Volver al inicio del perfil</div>
          <h3 style="font-size:22px; margin-top:6px">Cosmovisión</h3>
        </div>
        <a class="btn btn-primary" href="/perfil-egreso/cosmovision">Reiniciar recorrido →</a>
      </div>
    </section>
  </div>
</Base>
