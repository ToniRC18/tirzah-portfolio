---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import Reveal from '../../components/Reveal';

const items = [
  { icon: '1', title: "Decisiones sabias", desc: "Tomar decisiones sabias basadas en los principios de la Santa Biblia." },
  { icon: '2', title: "Compromiso moral y misional", desc: "Al proyectar una vida profesional, personal y familiar en el marco de un compromiso moral y misional." },
  { icon: '3', title: "Vida equilibrada", desc: "Al vivir una vida equilibrada teniendo especial cuidado en el uso del tiempo, las finanzas, las habilidades y la salud." },
  { icon: '4', title: "Recreación y cultura", desc: "Al desarrollar un gusto sano por la recreación, las manifestaciones artísticas y culturales y los medios." },
  { icon: '5', title: "Ética profesional", desc: "Al practicar los aspectos éticos, morales y legales del ejercicio profesional de la psicología clínica, sustentados en una cosmovisión bíblica." },
];
---

<Base title="Perfil de Egreso · Cosmovisión — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="Perfil de Egreso · 01/3"
      title="Cosmovisión"
      lead="Competencias relacionadas con la formación filosófica, ética y de valores que sustentan la práctica psicológica."
      client:load
    />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div style="display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap">
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso">← Volver al perfil</a>
        <a class="btn btn-primary btn-sm" href="/perfil-egreso/cosmovision">Cosmovisión</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/generacion">Generación y Aplicación</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/integracion">Integración</a>
      </div>

      <div class="competency-list">
        {items.map((it, i) => (
          <Reveal delay={i * 80} client:visible>
            <div class="competency-item">
              <div class="icon-wrap" style="flex-shrink:0; width:44px; height:44px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; font-size:20px">
                {it.icon}
              </div>
              <div style="flex:1">
                <h4>{it.title}</h4>
                <p>{it.desc}</p>
                <span class="evidence">Competencia de egreso</span>
              </div>
            </div>
          </Reveal>
        ))}
      </div>

      <div style="margin-top:64px; display:flex; justify-content:space-between; align-items:center; padding:24px 0; border-top:1px solid rgba(165,147,123,0.2); border-bottom:1px solid rgba(165,147,123,0.2); flex-wrap:wrap; gap:16px">
        <div>
          <div class="eyebrow">Siguiente competencia</div>
          <h3 style="font-size:22px; margin-top:6px">Generación y Aplicación</h3>
        </div>
        <a class="btn btn-primary" href="/perfil-egreso/generacion">Continuar →</a>
      </div>
    </section>
  </div>
</Base>
