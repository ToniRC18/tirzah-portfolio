---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import Reveal from '../../components/Reveal';

const items = [
  { icon: '🔍', title: "Pensamiento crítico", desc: "Análisis y evaluación de literatura científica con criterios metodológicos y éticos sólidos.", evidence: "Revisión sistemática · PSI-405" },
  { icon: '📊', title: "Métodos cuantitativos", desc: "Aplicación de análisis estadísticos básicos a problemas psicológicos reales.", evidence: "Reporte SPSS: ansiedad universitaria" },
  { icon: '📄', title: "Comunicación científica", desc: "Redacción académica en formato APA 7ª ed. y argumentación basada en evidencia.", evidence: "Artículo seminario · 2025" },
  { icon: '📋', title: "Diseño de evaluación", desc: "Selección y aplicación de instrumentos psicométricos pertinentes al contexto.", evidence: "Protocolo: tamizaje en adolescentes" },
];
---

<Base title="Perfil de Egreso · Generación y Aplicación — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="Perfil de Egreso · 02/3"
      title="Generación y Aplicación"
      lead="Competencias para producir conocimiento psicológico riguroso y aplicarlo en contextos reales."
      client:load
    />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div style="display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap">
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso">← Volver al perfil</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/cosmovision">Cosmovisión</a>
        <a class="btn btn-primary btn-sm" href="/perfil-egreso/generacion">Generación y Aplicación</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/integracion">Integración</a>
      </div>

      <div class="competency-list">
        {items.map((it, i) => (
          <Reveal delay={i * 80} client:visible>
            <div class="competency-item">
              <div class="icon-wrap" style="flex-shrink:0; width:44px; height:44px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; font-size:20px">
                {it.icon}
              </div>
              <div style="flex:1">
                <h4>{it.title}</h4>
                <p>{it.desc}</p>
                <span class="evidence">📄 {it.evidence}</span>
              </div>
            </div>
          </Reveal>
        ))}
      </div>

      <div style="margin-top:64px; display:flex; justify-content:space-between; align-items:center; padding:24px 0; border-top:1px solid rgba(165,147,123,0.2); border-bottom:1px solid rgba(165,147,123,0.2); flex-wrap:wrap; gap:16px">
        <div>
          <div class="eyebrow">Siguiente competencia</div>
          <h3 style="font-size:22px; margin-top:6px">Integración</h3>
        </div>
        <a class="btn btn-primary" href="/perfil-egreso/integracion">Continuar →</a>
      </div>
    </section>
  </div>
</Base>
