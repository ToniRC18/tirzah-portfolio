---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import Reveal from '../../components/Reveal';

const items = [
  { icon: '1', title: "Diagnóstico y tratamiento", desc: "Elaborar diagnósticos y tratamientos de padecimientos psicológicos fundamentados en la evaluación oportuna, de manera ética y responsable, utilizando las bases neuroanatómicas, neurofisiológicas, orgánicas y genéticas." },
  { icon: '2', title: "Modificación de conductas y pensamientos", desc: "Modificar conductas y pensamientos disfuncionales de los pacientes utilizando tratamientos psicológicos que alivien el sufrimiento físico, psíquico y espiritual, con sensibilidad al contexto y necesidades personales." },
  { icon: '3', title: "Programas de bienestar psicológico", desc: "Diseñar e implementar programas y proyectos que promuevan el bienestar psicológico de la comunidad, encaminados a fortalecer la salud mental, mostrando un compromiso con el servicio abnegado." },
  { icon: '4', title: "Intervenciones positivas", desc: "Realizar intervenciones psicológicas positivas potenciando las fortalezas y virtudes de los pacientes, gestionando su bienestar integral bajo una perspectiva bíblico-cristiana." },
  { icon: '5', title: "Investigación aplicada", desc: "Generar aportes significativos y de calidad relacionados con su profesión a partir de proyectos de investigación o de la aplicación de investigaciones." },
  { icon: '6', title: "Comunicación en español", desc: "Al comunicarse en forma oral y escrita en español." },
  { icon: '7', title: "Pensamiento crítico", desc: "Al identificar, plantear y resolver problemas aplicando el pensamiento crítico." },
  { icon: '8', title: "Tecnologías de información", desc: "Al usar correctamente las tecnologías de la información y comunicación." },
  { icon: '9', title: "Trabajo inter y multidisciplinario", desc: "Al trabajar en equipos inter y multidisciplinarios, con apertura y respeto pero manteniendo sus convicciones personales." },
];
---

<Base title="Perfil de Egreso · Generación y Aplicación — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="Perfil de Egreso · 02/3"
      title="Generación y Aplicación"
      lead="Transferir de modo pertinente e innovador el conocimiento profesional a situaciones laborales reales."
      client:load
    />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div style="display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap">
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso">← Volver al perfil</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/cosmovision">Cosmovisión</a>
        <a class="btn btn-primary btn-sm" href="/perfil-egreso/generacion">Generación y Aplicación</a>
        <a class="btn btn-ghost btn-sm" href="/perfil-egreso/integracion">Integración</a>
      </div>

      <div class="competency-list">
        {items.map((it, i) => (
          <Reveal delay={i * 80} client:visible>
            <div class="competency-item">
              <div class="icon-wrap" style="flex-shrink:0; width:44px; height:44px; border-radius:10px; background:var(--color-lavender-light); color:var(--color-lavender-dark); display:grid; place-items:center; font-size:20px">
                {it.icon}
              </div>
              <div style="flex:1">
                <h4>{it.title}</h4>
                <p>{it.desc}</p>
                <span class="evidence">Competencia de egreso</span>
              </div>
            </div>
          </Reveal>
        ))}
      </div>

      <div style="margin-top:64px; display:flex; justify-content:space-between; align-items:center; padding:24px 0; border-top:1px solid rgba(165,147,123,0.2); border-bottom:1px solid rgba(165,147,123,0.2); flex-wrap:wrap; gap:16px">
        <div>
          <div class="eyebrow">Siguiente competencia</div>
          <h3 style="font-size:22px; margin-top:6px">Integración</h3>
        </div>
        <a class="btn btn-primary" href="/perfil-egreso/integracion">Continuar →</a>
      </div>
    </section>
  </div>
</Base>
