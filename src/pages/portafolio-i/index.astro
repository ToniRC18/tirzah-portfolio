---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import PortfolioGrid from '../../components/PortfolioGrid';
import PortfolioSubNav from '../../components/PortfolioSubNav.astro';
import { PORTFOLIO_DATA } from '../../data/portafolios';

const data = PORTFOLIO_DATA.i;
---

<Base title="Portafolio I — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow="04 · Portafolio I" title={data.semester} lead={data.desc} decor="I" client:load />
    <section class="container" style="padding-bottom:var(--pad-section)">
      <PortfolioGrid data={data} which="i" client:load />
      <PortfolioSubNav portfolio="i" current="Académico-profesional" />
    </section>
  </div>
</Base>
