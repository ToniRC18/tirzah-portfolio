---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';
import CompetencyTable from '../../components/CompetencyTable.astro';
import PortfolioSubNav from '../../components/PortfolioSubNav.astro';
---

<Base title="Portafolio I · Tabla de competencias — Tirzah S. Kook">
  <div class="page">
    <PageHeader
      eyebrow="Portafolio I · Tabla de competencias"
      title="Competencias alcanzadas"
      lead="Tabla visual de las competencias institucionales alcanzadas durante el Portafolio I."
      decor="I"
      client:load
    />
    <section class="container" style="padding-bottom:var(--pad-section)">
      <CompetencyTable portfolio="i" />
      <PortfolioSubNav portfolio="i" current="Tabla de competencias" />
    </section>
  </div>
</Base>
