---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';

const subs = [
  { key: 'autobiografia', label: 'Autobiografía' },
  { key: 'cv', label: 'Curriculum Vitae' },
  { key: 'tarjeta', label: 'Tarjeta de presentación' },
  { key: 'declaracion', label: 'Declaración de afirmación' },
  { key: 'datos', label: 'Datos actuales UM' },
];

const pilares = [
  { t: "Cuidado", d: "Sostener al otro sin colonizar su proceso." },
  { t: "Rigor", d: "Pensar despacio, leer con atención, citar con honestidad." },
  { t: "Esperanza", d: "Confiar que la transformación es posible — siempre." },
];
---

<Base title="Declaración de afirmación — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow="01 · Generales" title="Sobre mí" lead="Lo personal y lo institucional." decor="01" client:load />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div class="with-sidebar">
        <aside class="sidebar-nav">
          {subs.map((s, i) => (
            <a class={`sidebar-link ${s.key === 'declaracion' ? 'active' : ''}`} href={`/generales/${s.key}`}>
              <span class="idx">0{i + 1}</span>{s.label}
            </a>
          ))}
        </aside>

        <article>
          <span class="eyebrow">Declaración de afirmación</span>
          <h2 style="margin-top:8px; margin-bottom:32px">Lo que me sostiene</h2>

          <div class="declaration" style="padding:120px 56px">
            <span class="eyebrow" style="display:block; margin-bottom:16px">Manifiesto personal</span>
            <p class="declaration-quote">
              «Soy estudiante porque la pregunta nunca se cierra. Soy psicóloga en formación porque
              alguien, en algún momento, me sostuvo cuando yo no podía hacerlo sola — y quiero
              aprender a hacer eso mismo, con cuidado, para alguien más.»
            </p>
            <div class="declaration-attr">— Tirzah, marzo 2026</div>
          </div>

          <div class="declaration-pillars">
            {pilares.map(p => (
              <div class="card" style="text-align:center; padding:32px">
                <h3 style="font-size:22px; font-style:italic; color:var(--color-lavender-dark)">{p.t}</h3>
                <p style="margin:12px 0 0; font-size:14px">{p.d}</p>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
