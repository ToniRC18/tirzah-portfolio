---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';

const subs = [
  { key: 'autobiografia', label: 'Autobiografía' },
  { key: 'cv', label: 'Curriculum Vitae' },
  { key: 'tarjeta', label: 'Tarjeta de presentación' },
  { key: 'declaracion', label: 'Declaración de afirmación' },
  { key: 'datos', label: 'Datos actuales UM' },
];

---

<Base title="Declaración de afirmación — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow="01 · Generales" title="Sobre mí" lead="Lo personal y lo institucional." decor="01" client:load />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div class="with-sidebar">
        <aside class="sidebar-nav">
          {subs.map((s, i) => (
            <a class={`sidebar-link ${s.key === 'declaracion' ? 'active' : ''}`} href={`/generales/${s.key}`}>
              <span class="idx">0{i + 1}</span>{s.label}
            </a>
          ))}
        </aside>

        <article>
          <span class="eyebrow">Declaración de afirmación</span>
          <h2 style="margin-top:8px; margin-bottom:32px">Afirmación de autoría</h2>

          <div class="declaration" style="padding:120px 56px">
            <span class="eyebrow" style="display:block; margin-bottom:16px">Declaración</span>
            <p class="declaration-quote">
              «Yo, Tirzah Shiraldin Kook declaro que todos los trabajos, reflexiones y aportaciones
              presentados en este portafolio han sido elaborados por mi persona, en excepción de
              aquellas asignaciones en las que he trabajado en conjunto con mis compañeros de clase.
              De igual forma, ha sido elaborado con la ayuda de mi tutor.»
            </p>
            <div class="declaration-attr">— Tirzah Shiraldin Kook</div>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
