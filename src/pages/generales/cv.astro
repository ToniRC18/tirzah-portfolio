---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';

const subs = [
  { key: 'autobiografia', label: 'Autobiografía' },
  { key: 'cv', label: 'Curriculum Vitae' },
  { key: 'tarjeta', label: 'Tarjeta de presentación' },
  { key: 'declaracion', label: 'Declaración de afirmación' },
  { key: 'datos', label: 'Datos actuales UM' },
];

const idiomas = [
  ["Nativo", "Papiamentu"],
  ["Avanzado", "Holandés"],
  ["Avanzado", "Inglés"],
  ["Avanzado", "Español"],
  ["Intermedio medio", "Francés"],
];
---

<Base title="Curriculum Vitae — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow="01 · Generales" title="Sobre mí" lead="Lo personal y lo institucional: quién soy, lo que me trajo hasta aquí y lo que me identifica como estudiante de la Universidad de Montemorelos." decor="01" client:load />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div class="with-sidebar">
        <aside class="sidebar-nav">
          {subs.map((s, i) => (
            <a class={`sidebar-link ${s.key === 'cv' ? 'active' : ''}`} href={`/generales/${s.key}`}>
              <span class="idx">0{i + 1}</span>{s.label}
            </a>
          ))}
        </aside>

        <article>
          <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:24px; flex-wrap:wrap; gap:16px">
            <div>
              <span class="eyebrow">Curriculum Vitae</span>
              <h2 style="margin-top:8px">Trayectoria académica</h2>
            </div>
            <button class="btn btn-secondary btn-sm">
              ↓ Descargar PDF
            </button>
          </div>

          <div class="cv">
            <div class="cv-header">
              <div>
                <h3 class="cv-name">Tirzah S Kook</h3>
                <p style="margin:6px 0 0; color:var(--color-charcoal)">Licenciatura en Psicología Clínica</p>
              </div>
              <div style="text-align:right; font-size:13px; color:var(--color-taupe)">
                <div>✉ tirzahkook0126@gmail.com</div>
                <div style="margin-top:4px">📍 Montemorelos, NL</div>
                <div style="margin-top:4px">📸 @__txr.zxh__</div>
              </div>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Cualidades</div>
              <p style="margin:0; color:var(--color-charcoal)">
                Trabajadora, ambiciosa y proactiva. Desarrollar constantemente nuevas habilidades
                y capacidades.
              </p>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Formación y Educación</div>
              <div class="cv-row">
                <div class="cv-period">Presente</div>
                <div>
                  <div class="cv-title">Licenciatura en Psicología Clínica</div>
                  <div class="cv-meta">Universidad de Montemorelos</div>
                </div>
              </div>
              <div class="cv-row">
                <div class="cv-period">2016 — 2022</div>
                <div>
                  <div class="cv-title">Preparatoria</div>
                  <div class="cv-meta">Maria Immaculata Lyceum</div>
                </div>
              </div>
              <div class="cv-row">
                <div class="cv-period">2008 — 2016</div>
                <div>
                  <div class="cv-title">Escuela primaria y secundaria</div>
                  <div class="cv-meta">Adventschool Mahuma Zuid</div>
                </div>
              </div>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Experiencia laboral</div>
              <div class="cv-row">
                <div class="cv-period">2023</div>
                <div>
                  <div class="cv-title">Instituto Municipal de la Juventud</div>
                  <ul class="cv-bullets">
                    <li>Voluntaria en atención psicológica a los jóvenes.</li>
                  </ul>
                </div>
              </div>
              <div class="cv-row">
                <div class="cv-period">2019</div>
                <div>
                  <div class="cv-title">Colportaje</div>
                  <ul class="cv-bullets">
                    <li>Venta de libros como representante de la editorial IADPA.</li>
                  </ul>
                </div>
              </div>
              <div class="cv-row">
                <div class="cv-period">2023 — 2025</div>
                <div>
                  <div class="cv-title">Instituto de Idiomas</div>
                  <ul class="cv-bullets">
                    <li>Docente de Inglés</li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Idiomas</div>
              {idiomas.map(([nivel, idioma]) => (
                <div class="cv-row">
                  <div class="cv-period">{nivel}</div>
                  <div><div class="cv-title">{idioma}</div></div>
                </div>
              ))}
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Referencias</div>
              <p style="margin:0; color:var(--color-charcoal)">Disponibles bajo petición.</p>
            </div>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
