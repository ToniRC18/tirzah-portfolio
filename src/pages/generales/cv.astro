---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader';

const subs = [
  { key: 'autobiografia', label: 'Autobiografía' },
  { key: 'cv', label: 'Curriculum Vitae' },
  { key: 'tarjeta', label: 'Tarjeta de presentación' },
  { key: 'declaracion', label: 'Declaración de afirmación' },
  { key: 'datos', label: 'Datos actuales UM' },
];

const experiencias = [
  {
    periodo: "Abril 2026 — Mayo 2026",
    titulo: "Hospital de Especialidades en Salud Mental",
    meta: "Practicante",
  },
  {
    periodo: "Enero 2026 — Marzo 2026",
    titulo: 'Colegio Militarizado "Mariano Escobedo" Plantel Montemorelos',
    meta: "Practicante",
  },
  {
    periodo: "Noviembre 2025",
    titulo: "CAISMA Zona Sur",
    meta: "Practicante",
  },
  {
    periodo: "2023 — presente",
    titulo: "Instituto de Idiomas",
    meta: "Docente de idioma extranjero Inglés · Traductora de documentos",
  },
  {
    periodo: "Agosto 2025 — Diciembre 2025",
    titulo: "Escuela Preparatoria Ignacio Carrillo Franco",
    meta: "Docente de idioma extranjero Inglés",
  },
];

const habilidades = [
  "Aplicación e interpretación de pruebas psicométricas",
  "Diseño e implementación de intervenciones terapéuticas",
  "Aplicación e interpretación de pruebas proyectivas",
  "Desarrollo de programas de intervención para grupos específicos",
  "Diseño de programas de intervención comunitaria",
  "Planeación y organización de congresos y actividades académicas",
];
---

<Base title="Curriculum Vitae — Tirzah S. Kook">
  <div class="page">
    <PageHeader eyebrow="01 · Generales" title="Sobre mí" lead="Lo personal y lo institucional: quién soy, lo que me trajo hasta aquí y lo que me identifica como estudiante de la Universidad de Montemorelos." decor="01" client:load />

    <section class="container" style="padding-bottom:var(--pad-section)">
      <div class="with-sidebar">
        <aside class="sidebar-nav">
          {subs.map((s, i) => (
            <a class={`sidebar-link ${s.key === 'cv' ? 'active' : ''}`} href={`/generales/${s.key}`}>
              <span class="idx">0{i + 1}</span>{s.label}
            </a>
          ))}
        </aside>

        <article>
          <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:24px; flex-wrap:wrap; gap:16px">
            <div>
              <span class="eyebrow">Curriculum Vitae</span>
              <h2 style="margin-top:8px">Trayectoria académica</h2>
            </div>
            <a
              href="/assets/cv.jpeg"
              download="CV-Tirzah-Kook.jpeg"
              class="btn btn-secondary btn-sm"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Descargar CV
            </a>
          </div>

          <div class="cv">
            <div class="cv-header">
              <div>
                <h3 class="cv-name">Tirzah S. Kook</h3>
                <p style="margin:6px 0 0; color:var(--color-charcoal)">Lic. Psicología Clínica</p>
              </div>
              <div style="text-align:right; font-size:13px; color:var(--color-taupe)">
                <div>✉ tirzahkook0126@gmail.com</div>
                <div style="margin-top:4px">☎ +52 81 2632 1572</div>
                <div style="margin-top:4px">📍 Montemorelos, Nuevo León, México</div>
                <div style="margin-top:4px">📸 @__txr.zxh__</div>
              </div>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Sobre mí</div>
              <p style="margin:0; color:var(--color-charcoal)">
                Nací en Curazao el 26 de enero de 2004. Me considero una persona proactiva, con
                gran interés por aprender cosas nuevas y enfrentar retos que me permitan desarrollar
                mi máximo potencial. Disfruto actividades como la lectura, la natación, la cocina y
                la repostería, así como cantar, viajar y explorar nuevos lugares.
              </p>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Formación</div>
              <div class="cv-row">
                <div class="cv-period">2022 — presente</div>
                <div>
                  <div class="cv-title">Licenciatura en Psicología Clínica</div>
                  <div class="cv-meta">Universidad de Montemorelos</div>
                </div>
              </div>
              <div class="cv-row">
                <div class="cv-period">2016 — 2022</div>
                <div>
                  <div class="cv-title">Preparatoria</div>
                  <div class="cv-meta">Maria Immaculata Lyceum</div>
                </div>
              </div>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Idiomas</div>
              <p style="margin:0; color:var(--color-charcoal)">
                Papiamentu · Holandés · Inglés · Español · Francés
              </p>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Línea de investigación</div>
              <p style="margin:0; color:var(--color-charcoal); font-family:var(--font-serif); font-style:italic; font-size:18px">
                "Funcionamiento familiar y conducta disocial como predictores de la autoeficacia académica"
              </p>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Experiencia laboral</div>
              {experiencias.map((exp) => (
                <div class="cv-row">
                  <div class="cv-period">{exp.periodo}</div>
                  <div>
                    <div class="cv-title">{exp.titulo}</div>
                    <div class="cv-meta">{exp.meta}</div>
                  </div>
                </div>
              ))}
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Habilidades</div>
              <ul class="cv-bullets" style="margin:0">
                {habilidades.map((habilidad) => (
                  <li>{habilidad}</li>
                ))}
              </ul>
            </div>

            <div class="cv-section">
              <div class="cv-section-title">Contacto</div>
              <div class="stack-2" style="font-size:14px; color:var(--color-charcoal)">
                <div>Montemorelos, Nuevo León, México</div>
                <div><a href="mailto:tirzahkook0126@gmail.com">tirzahkook0126@gmail.com</a></div>
                <div><a href="tel:+528126321572">+52 81 2632 1572</a></div>
                <div>Instagram: <a href="https://instagram.com/__txr.zxh__" target="_blank" rel="noreferrer">@__txr.zxh__</a></div>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
